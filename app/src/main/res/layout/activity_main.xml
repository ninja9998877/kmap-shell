<?xml version="1.0" encoding="utf-8"?>
<!--
  两层叠着，**不是"加载中先显示 WebView"**：

    WebView          只有页面真的画出来了才揭开（onPageFinished）
    诊断面板          其余所有时刻都盖在上面

  这样"白屏"这个状态根本不存在 —— 任何连不上的情况都落在那块面板上，
  而那块面板会写清楚是哪一种连不上。

  面板外面套 ScrollView：横屏平板的高度很有限（1280×800 的机器横过来只有 800px），
  403 原文一长就会溢出。溢出被裁掉的后果是"最有用那段诊断信息看不见"。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/diagView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/ink3"
                android:textSize="14sp" />

            <!-- 一句话说清出了什么事。绝不写成"连接失败"。 -->
            <TextView
                android:id="@+id/diagHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- 这一类原因意味着什么、下一步该做什么。 -->
            <TextView
                android:id="@+id/diagReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink2"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.25" />

            <!-- 地址一行：左边能改，右边两个按钮。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/serverUrl"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="@string/hint_server"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink3"
                    android:textSize="16sp"
                    android:background="@color/surface"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <Button
                    android:id="@+id/connectBtn"
                    style="@style/DiagButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/btn_connect" />

                <Button
                    android:id="@+id/scanBtn"
                    style="@style/DiagButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/btn_scan" />
            </LinearLayout>

            <!--
              服务端自己说的话，原样照抄。
              最有用的一条：403 的正文里写着**是哪台设备被挡、允许的网段是什么** ——
              那是整个 kmap 里诊断信息写得最好的一段，白扔了太可惜。
            -->
            <TextView
                android:id="@+id/diagServerMsg"
                style="@style/ServerOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

            <!-- 三条家长自己能查的。措辞里不放任何"请联系管理员"这种没法执行的话。 -->
            <TextView
                android:id="@+id/diagChecks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/ink2"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <!-- /api/health 说的：这台服务连的是哪一份进度文件。
                 能一眼看出平板是不是连到了**测试用的 scratch 进度**。 -->
            <TextView
                android:id="@+id/diagHealth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/ink3"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- 构建号。家长拍一张截图，就能确定平板上装的是哪个构建。 -->
            <TextView
                android:id="@+id/diagBuild"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="monospace"
                android:textColor="@color/ink3"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
