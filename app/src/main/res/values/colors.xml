<?xml version="1.0" encoding="utf-8"?>
<!--
  这几个值是从 kmap/learn.html 的 :root 里抄的，**必须跟那边一致**。
  不一致的症状是冷启动到首帧之间闪一块别的颜色 —— 在平板上很显眼，
  而且看起来像"app 卡了一下"。
-->
<resources>
    <color name="paper">#FDF7EC</color>
    <color name="surface">#FFFFFF</color>
    <color name="ink">#2B2118</color>
    <color name="ink2">#5C5044</color>
    <color name="ink3">#8C7F70</color>
    <color name="rule2">#C9B99F</color>
    <!-- --bad / --badbg：失败界面要"看起来像出了问题"，用的是页面里同一个红 -->
    <color name="bad">#D9542F</color>
    <color name="badbg">#FCE4DA</color>
    <!-- --ok / --okbg：这几行是给孩子看的 -->
    <color name="ok">#3F9A5E</color>
    <color name="g2">#3FA9D6</color>
</resources>
